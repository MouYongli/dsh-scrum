{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "paths": {
      "@dsh-scrum/adapter-audit-local": ["./packages/adapters/adapter-audit-local/src/index.ts"],
      "@dsh-scrum/adapter-identity-personal": [
        "./packages/adapters/adapter-identity-personal/src/index.ts"
      ],
      "@dsh-scrum/adapter-storage-workspace-files": [
        "./packages/adapters/adapter-storage-workspace-files/src/index.ts"
      ],
      "@dsh-scrum/edition-community": ["./packages/editions/edition-community/src/index.ts"],
      "@dsh-scrum/scrum-agent-tools": ["./packages/harness/scrum-agent-tools/src/index.ts"],
      "@dsh-scrum/scrum-api-contract": ["./packages/api/scrum-api-contract/src/index.ts"],
      "@dsh-scrum/scrum-application": ["./packages/core/scrum-application/src/index.ts"],
      "@dsh-scrum/scrum-domain": ["./packages/core/scrum-domain/src/index.ts"],
      "@dsh-scrum/scrum-harness-bundle": ["./packages/harness/scrum-harness-bundle/src/index.ts"],
      "@dsh-scrum/scrum-harness-bundle/client": [
        "./packages/harness/scrum-harness-bundle/src/client/index.ts"
      ],
      "@dsh-scrum/scrum-harness-client": ["./packages/harness/scrum-harness-client/src/index.ts"],
      "@dsh-scrum/scrum-harness-client/client": [
        "./packages/harness/scrum-harness-client/src/client/index.ts"
      ],
      "@dsh-scrum/scrum-ui": ["./packages/ui/scrum-ui/src/index.ts"],
      "@dsh-scrum/scrum-harness-host": ["./packages/harness/scrum-harness-host/src/index.ts"]
    }
  },
  "include": ["packages/*/*/src/**/*.ts", "packages/*/*/tests/**/*.ts", "tests/**/*.ts"]
}
