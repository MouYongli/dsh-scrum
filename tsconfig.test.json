{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // `tests/workspace/dependency-boundaries.test.ts` imports the rule factory
    // from `.dependency-cruiser.mjs`, which dependency-cruiser has to be able
    // to load directly and so cannot be TypeScript.
    "allowJs": true,
    // The browser components are driven in a jsdom document by the tests under
    // `tests/integration`, so the test program needs the DOM library the
    // packages themselves already compile against.
    "lib": ["es2023", "dom"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "packages/*/*/tests/**/*.ts",
    "packages/*/*/*.config.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["tests/fixtures/**"]
}
