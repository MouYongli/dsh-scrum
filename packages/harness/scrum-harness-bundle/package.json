{
  "name": "@dsh-scrum/scrum-harness-bundle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness installable bundle",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@dsh-scrum/adapter-storage-workspace-files": "workspace:*",
    "@dsh-scrum/edition-community": "workspace:*",
    "@dsh-scrum/scrum-agent-tools": "workspace:*",
    "@dsh-scrum/scrum-application": "workspace:*",
    "@dsh-scrum/scrum-domain": "workspace:*",
    "@dsh-scrum/scrum-ui": "workspace:*",
    "tsdown": "^0.22.14",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.8",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@dsh-scrum/edition-community": "workspace:*",
    "@dsh-scrum/scrum-harness-client": "workspace:*",
    "@dsh-scrum/scrum-harness-host": "workspace:*",
    "@dsh-scrum/scrum-api-contract": "workspace:*"
  }
}
